<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused state -->
    <item android:state_focused="true">

        <shape>

            <solid android:color="#FFFFFF"/>

            <stroke
                android:width="2dp"
                android:color="#003A82"/>

            <corners android:radius="8dp"/>

            <padding
                android:left="10dp"
                android:top="6dp"
                android:right="10dp"
                android:bottom="6dp"/>

        </shape>

    </item>

    <!-- Default state -->
    <item>

        <shape>

            <solid android:color="#FFFFFF"/>

            <stroke
                android:width="1dp"
                android:color="#CFCFCF"/>

            <corners android:radius="8dp"/>

            <padding
                android:left="10dp"
                android:top="6dp"
                android:right="10dp"
                android:bottom="6dp"/>

        </shape>

    </item>

</selector>