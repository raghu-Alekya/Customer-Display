<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/contactless_icon"
        android:layout_width="match_parent"
        android:layout_marginTop="90dp"
        android:layout_height="120dp"
        android:src="@drawable/contactless_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/separator"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/contactless_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@android:color/black"/>

    <ImageView
        android:id="@+id/mastercard_item"
        android:src="@drawable/mastercard_icon"
        android:layout_width="70dp"
        android:layout_height="70dp"
        tools:ignore="MissingConstraints"/>
    <ImageView
        android:id="@+id/visa_item"
        android:src="@drawable/visa_icon"
        android:layout_width="70dp"
        android:layout_height="70dp"
        tools:ignore="MissingConstraints"/>
    <ImageView
        android:id="@+id/amex_item"
        android:src="@drawable/amex_icon"
        android:layout_width="70dp"
        android:layout_height="70dp"
        tools:ignore="MissingConstraints"/>
    <ImageView
        android:id="@+id/discover_item"
        android:src="@drawable/discover_icon"
        android:layout_width="70dp"
        android:layout_height="70dp"
        tools:ignore="MissingConstraints"/>

    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/supported_cards"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:flow_wrapMode="chain"
        app:constraint_referenced_ids="mastercard_item, visa_item, amex_item, discover_item"
        app:flow_horizontalGap="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/separator"/>

    <TextView
        android:id="@+id/tap_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap Your Card"
        android:textSize="40sp"
        android:textStyle="bold"
        android:layout_marginTop="50dp"
        android:textColor="@android:color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/supported_cards" />

    <TextView
        android:id="@+id/transaction_update"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tap_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/user_notification"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/transaction_update"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/terminate_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="50dp"
        android:text="Terminate"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>